# Copy to .env and fill the key locally. Never commit .env.
OPENAI_API_KEY=
DATABASE_URL=postgresql://rag:rag_local@localhost:55432/rag
AGENT_MODEL=gpt-5-mini
# Opt-in agent_v2 (baseline does not use these settings)
AGENT_V2_ROUTING_MODEL=gpt-5-nano
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=focused-take-home
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Agent-based LangSmith workspaces: set both fields to route to an existing agent.
# LANGSMITH_AGENT_ID=focused
# LANGSMITH_AGENT_ENVIRONMENT=local
# EU workspaces use LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Web backend
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_LIMIT=5
MAX_QUESTION_LENGTH=2000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
